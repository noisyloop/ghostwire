[Unit]
Description=ghostwire — passive USB anomaly detection daemon
Documentation=https://github.com/m0rs3c0d3/ghostwire
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ghostwire
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghostwire

# Runtime directories (systemd creates these before ExecStart)
RuntimeDirectory=ghostwire
StateDirectory=ghostwire
LogsDirectory=ghostwire
StateDirectoryMode=0700
LogsDirectoryMode=0700
UMask=0077

# Privilege hardening — only CAP_NET_ADMIN needed for the netlink uevent socket
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ReadWritePaths=/var/lib/ghostwire /var/log/ghostwire

# Allow reading sysfs for device attributes
ReadOnlyPaths=/sys

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Only netlink (uevents) and unix (journald) sockets are ever needed.
# Do NOT add PrivateNetwork=: uevents are only broadcast to the host netns.
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
